# Application and Better Auth
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated browser origins permitted to call Better Auth (for example,
# https://your-app.vercel.app). Set BETTER_AUTH_URL to that same canonical URL in production.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-32-character-minimum-secret

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/at_psd

# SMTP for Better Auth verification and password-reset emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=A.T PSD <no-reply@example.com>

# Cloudinary: authenticated raw PSD uploads and public image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_PSD_SIZE_MB=1024
MAX_PREVIEW_SIZE_MB=15

# Local-only initial administrator. Never commit real values.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-local-password
